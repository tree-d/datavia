# Include the README and LICENSE
include README.md
include LICENSE

# Include configuration files
recursive-include datavia/config *.yaml *.yml *.json

# Include documentation
recursive-include datavia/docs *
prune datavia/docs/_build

# Include test data (if any)
recursive-include datavia/tests/data *

# Include examples
recursive-include datavia/examples *.py

# Exclude development files
exclude .gitignore
exclude pixi.toml
exclude pixi.lock
prune .git
prune __pycache__
prune *.pyc
prune .pytest_cache